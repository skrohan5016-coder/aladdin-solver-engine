fixture = '''{
  "auctionId": "42001",
  "solutionId": [
    7,
    9007199254740993
  ],
  "kind": "success",
  "rank": 2,
  "details": {
    "objective": "123456789012345678901234567890",
    "driverVersion": "pinned-fixture"
  }
}
'''
(ROOT / "testdata/contracts/notification-extra.json").write_text(fixture)
manifest_path = ROOT / "testdata/contracts/manifest.json"
manifest = json.loads(manifest_path.read_text())
for item in manifest["fixtures"]:
    if item["path"] == "notification-extra.json":
        item["sha256"] = hashlib.sha256(fixture.encode()).hexdigest()
        break
else:
    raise SystemExit("notification fixture not listed")
manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
