#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def replace_once(path: str, old: str, new: str) -> None:
    target = ROOT / path
    text = target.read_text()
    if text.count(old) != 1:
        raise SystemExit(f"{path}: replacement count for {old[:40]!r} is {text.count(old)}")
    target.write_text(text.replace(old, new, 1))


# contract.go: bind runtime notification DTO, validate Option<i64> and
# Option<Single(u64)|Merged(Vec<u64>)>, and reject null required scalars.
replace_once("internal/contract/contract.go", '\t"sort"\n', '\t"sort"\n\t"strconv"\n')
replace_once(
    "internal/contract/contract.go",
    '\t"crates/solvers-dto/src/auction.rs":                            "6c82fd4e461a32d73453feb68d79686642f802d6",\n',
    '\t"crates/solvers-dto/src/auction.rs":                            "6c82fd4e461a32d73453feb68d79686642f802d6",\n'
    '\t"crates/solvers-dto/src/notification.rs":                       "dbbff28c235d3ba7fc559d774ba06a305385fffb",\n',
)
start = "func ValidateNotificationJSON(data []byte) error {\n"
end = "\nfunc object(raw []byte, path string)"
path = ROOT / "internal/contract/contract.go"
text = path.read_text()
left, found, rest = text.partition(start)
if not found:
    raise SystemExit("notification validator start missing")
_, found, right = rest.partition(end)
if not found:
    raise SystemExit("notification validator end missing")
validator = r'''func ValidateNotificationJSON(data []byte) error {
	if err := ValidateUniqueJSON(data); err != nil {
		return err
	}
	value, err := object(data, "notification")
	if err != nil {
		return err
	}
	kind, ok := value["kind"]
	if !ok {
		return errors.New("notification: missing required field \"kind\"")
	}
	if err := stringValue(kind, "notification.kind"); err != nil {
		return err
	}
	if raw, ok := value["auctionId"]; ok && !isNull(raw) {
		var id string
		if err := json.Unmarshal(raw, &id); err != nil {
			return errors.New("notification.auctionId: expected decimal string or null")
		}
		if _, err := strconv.ParseInt(id, 10, 64); err != nil {
			return fmt.Errorf("notification.auctionId: invalid i64: %w", err)
		}
	}
	if raw, ok := value["solutionId"]; ok && !isNull(raw) {
		if err := notificationSolutionIDValue(raw, "notification.solutionId"); err != nil {
			return err
		}
	}
	return nil
}

func notificationSolutionIDValue(raw json.RawMessage, path string) error {
	trimmed := bytes.TrimSpace(raw)
	if len(trimmed) > 0 && trimmed[0] == '[' {
		items, err := array(raw, path)
		if err != nil {
			return err
		}
		for index, item := range items {
			if err := uint64NumberValue(item, fmt.Sprintf("%s[%d]", path, index)); err != nil {
				return err
			}
		}
		return nil
	}
	return uint64NumberValue(raw, path)
}

func uint64NumberValue(raw json.RawMessage, path string) error {
	if isNull(raw) {
		return fmt.Errorf("%s: expected uint64", path)
	}
	decoder := json.NewDecoder(bytes.NewReader(raw))
	decoder.UseNumber()
	var value json.Number
	if err := decoder.Decode(&value); err != nil || value.String() == "" {
		return fmt.Errorf("%s: expected uint64", path)
	}
	if _, err := strconv.ParseUint(value.String(), 10, 64); err != nil {
		return fmt.Errorf("%s: expected uint64: %w", path, err)
	}
	return nil
}'''
path.write_text(left + validator + end + right)

for name, kind in (("stringValue", "string"), ("boolValue", "boolean"), ("numberValue", "number")):
    signature = f"func {name}(raw json.RawMessage, path string) error {{\n"
    text = path.read_text()
    before, found, tail = text.partition(signature)
    if not found:
        raise SystemExit(f"{name} missing")
    body, found, after = tail.partition("\n}\n")
    if not found:
        raise SystemExit(f"{name} end missing")
    if "isNull(raw)" not in body:
        body = f'\tif isNull(raw) {{\n\t\treturn fmt.Errorf("%s: expected {kind}", path)\n\t}}\n' + body
    if name == "numberValue":
        body = body.replace(
            'if err := decoder.Decode(&value); err != nil {',
            'if err := decoder.Decode(&value); err != nil || value.String() == "" {',
        )
    path.write_text(before + signature + body + "\n}\n" + after)

# types.go: replace only the notification section.
types = ROOT / "internal/api/types.go"
text = types.read_text()
if '"strconv"' not in text:
    text = text.replace('\t"fmt"\n', '\t"fmt"\n\t"strconv"\n')
marker = "// ---------- Notification (driver -> solver) 