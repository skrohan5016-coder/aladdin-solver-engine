pin = json.loads(pin_path.read_text())
pin["authorityOrder"].insert(pin["authorityOrder"].index("driver-auction-serialization"), "runtime-notification-dto")
pin["files"].insert(
    next(i for i, item in enumerate(pin["files"]) if item["path"].endswith("/solution.rs")),
    {"blob": "dbbff28c235d3ba7fc559d774ba06a305385fffb", "path": "crates/solvers-dto/src/notification.rs", "role": "runtime-notification-dto"},
)
pin["knownDiscrepancies"].append(
    {"field": "Notification.solutionId", "openapi": "number", "rule": "accept optional single or merged uint64 IDs losslessly; runtime DTO is authoritative", "runtimeDto": "u64 | u64[] | null"}
)
pin_path.write_text(json.dumps(pin, indent=2) + "\n")

