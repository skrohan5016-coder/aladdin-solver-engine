# Install: sudo cp deploy/solver.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now solver
[Unit]
Description=CoW solver engine (shadow)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solver
WorkingDirectory=/opt/solver
ExecStart=/opt/solver/bin/solver
Restart=always
RestartSec=5
UMask=0027

Environment=LISTEN_ADDR=127.0.0.1:8000
Environment=RECORD_DIR=/opt/solver/data
Environment=RECORD_FULL_AUCTIONS=false
Environment=LOG_LEVEL=info
Environment=REQUIRE_PROFITABLE=true
Environment=MAX_POOLS=2048

# The shadow process needs only loopback HTTP access to the local driver and
# write access to its evidence directory. External network egress is denied.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/opt/solver/data
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
SystemCallArchitectures=native
MemoryMax=2G
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
